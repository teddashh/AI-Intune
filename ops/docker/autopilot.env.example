# Copy to autopilot.env, chmod 0600, and edit. Never commit secrets.
# DNS hostname only: no scheme, path, or port. Point its A record at this host.
CLAWCTL_PUBLIC_HOST=hub.example.com
# Replace with the literal output of git rev-parse --short HEAD.
# A unique version seeds fresh agent bundles; reusing dev does not refresh them.
CLAWCTL_VERSION=dev

# Optional: omit entirely to generate and log a fresh code at first startup.
# At least 16 characters after removing spaces/hyphens; do not set empty.
# CLAWCTL_SETUP_CODE=replace-with-a-long-random-secret

# Notifications: see ops/notify.env.example and docs/DEPLOY-OSS.md.
# Keep -p clawctl-autopilot when adding -f ops/docker/docker-compose.notify.yml
# (the legacy override declares a different project name). Set CLAWCTL_NOTIFY_ENV_HOST
# to a mode-0600 file owned by UID 65532; container path: /etc/clawctl/notify.env.
# CLAWCTL_NOTIFY_ENV_HOST=/absolute/path/to/notify.env
# CLAWCTL_REPORT_AT=08:00
# CLAWCTL_REPORT_PING_URL=https://hc-ping.com/<uuid>
# CLAWCTL_REPORT_PING_FAIL_URL=

# Optional R2/S3 artifact storage: docs/DEPLOY-OSS.md section 5 and
# hub.env.example list the R2_* / S3_* variables. The pack passes both groups.
# Leave unset for local storage. Never configure both providers together.
