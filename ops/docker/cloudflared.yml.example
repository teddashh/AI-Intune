# Example Cloudflare Tunnel config for clawctl-hub agent-plane experiments.
#
# Prefer the dashboard token install. Put CLOUDFLARE_TUNNEL_TOKEN in hub.env
# and add -f ops/docker/docker-compose.tunnel.yml. Do not put the token in
# docker-compose.yml: Compose v5 interpolates that file even when a profile
# is off, and a required token there aborts every command.
# If you use this config file instead, keep credentials JSON outside git
# (chmod 600) and point credentials-file at it. The tunnel compose file
# comments show the volume mount that replaces the token command.
#
# Replace 100.64.0.12:8787 with THIS host's CLAWCTL_LISTEN value.
# The origin port is that listen port. 8787 here is the conventional example, not a Hub default.
# Hub only binds that Tailscale IP — do not use 127.0.0.1 or localhost here
# unless you have also changed Hub to listen there (it currently refuses).

tunnel: <TUNNEL_UUID>
credentials-file: /etc/cloudflared/<TUNNEL_UUID>.json

ingress:
  # Experimental public agent ingress. Agents may use https://hub.example.com
  # as hub_url; machine bearer routes do not pin Host today.
  # Operator UI at this hostname will fail Host authority + LocalAPI WhoIs.
  - hostname: hub.example.com
    service: http://100.64.0.12:8787
    originRequest:
      # Do not invent X-Forwarded-* identity; Hub ignores those headers for auth.
      noTLSVerify: false
  - service: http_status:404
