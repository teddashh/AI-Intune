# clawctl-hub environment (copy to hub.env and fill in — hub.env is gitignored).
# Never commit real tokens, tunnel credentials, or R2 secrets.

# ---------------------------------------------------------------------------
# REQUIRED — Tailscale operator plane
# ---------------------------------------------------------------------------

# Literal Tailscale node IPv4 + port. MUST be this host's `tailscale ip -4`.
# Rejected by Hub: 0.0.0.0, 127.0.0.1, LAN/public IPs, hostnames, MagicDNS.
# Example: CLAWCTL_LISTEN=100.64.0.12:8787
CLAWCTL_LISTEN=

# App capability prefix owned by your domain (no trailing -view/-operate/-admin).
# Hub requires exact keys: <prefix>-view, <prefix>-operate, <prefix>-admin
# in Tailscale grants. See docs/OPERATOR-AUTH.md.
# Example: CLAWCTL_OPERATOR_CAPABILITY_PREFIX=example.com/cap/clawctl
CLAWCTL_OPERATOR_CAPABILITY_PREFIX=

# ---------------------------------------------------------------------------
# Paths (Docker defaults — override only if you know why)
# ---------------------------------------------------------------------------

CLAWCTL_DB=/var/lib/clawctl/clawctl.sqlite
CLAWCTL_REPORT_STAMP=/var/lib/clawctl/last-report.stamp
CLAWCTL_REPORT_AT=08:00

# Optional. If set, MUST equal http://<CLAWCTL_LISTEN> (trailing slash ignored).
# Any other value is rejected before the DB opens.
# CLAWCTL_PUBLIC_URL=http://100.64.0.12:8787

# ---------------------------------------------------------------------------
# Notifications / deadman (optional)
# ---------------------------------------------------------------------------

# CLAWCTL_NOTIFY_CMD=/path/to/notify-telegram.sh
# CLAWCTL_REPORT_PING_URL=https://hc-ping.com/<uuid>
# CLAWCTL_REPORT_PING_FAIL_URL=

# ---------------------------------------------------------------------------
# Optional Cloudflare Tunnel (compose profile: tunnel)
# ---------------------------------------------------------------------------

# From Zero Trust → Networks → Tunnels → configure → install with token.
# CLOUDFLARE_TUNNEL_TOKEN=
#
# Point the tunnel's public hostname service URL at:
#   http://<same CLAWCTL_LISTEN value>
# Operator UI on that hostname will NOT authenticate today.
# Agent check-in over the public hostname is experimental only.

# ---------------------------------------------------------------------------
# Future: Cloudflare R2 for large artifacts / evidence blobs (NOT wired yet)
# SQLite remains the source of truth for fleet state. R2 is for bulky objects.
# Scaffold only — Hub code does not read these in Milestone 1.
# ---------------------------------------------------------------------------

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=clawctl-artifacts
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
