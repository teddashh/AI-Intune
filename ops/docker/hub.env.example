# clawctl-hub environment (copy to hub.env and fill in — hub.env is gitignored).
# Never commit real tokens, tunnel credentials, or R2 secrets.

# ---------------------------------------------------------------------------
# REQUIRED — Tailscale operator plane
# ---------------------------------------------------------------------------

# Literal Tailscale node IPv4 + port. MUST be this host's `tailscale ip -4`.
# Hub has no production default port. The flag default 127.0.0.1:8770 is refused.
# 8787 below is the conventional example only. Grant dst, CLAWCTL_PUBLIC_URL,
# agent --hub, and any tunnel origin must use this same port.
# Rejected by Hub: 0.0.0.0, 127.0.0.1, LAN/public IPs, hostnames, MagicDNS.
# Example: CLAWCTL_LISTEN=100.64.0.12:8787
CLAWCTL_LISTEN=

# App capability prefix owned by your domain (no trailing -view/-operate/-admin).
# Hub requires exact keys: <prefix>-view, <prefix>-operate, <prefix>-admin
# in Tailscale grants. See docs/OPERATOR-AUTH.md.
# Example: CLAWCTL_OPERATOR_CAPABILITY_PREFIX=example.com/cap/clawctl
CLAWCTL_OPERATOR_CAPABILITY_PREFIX=

# ---------------------------------------------------------------------------
# Paths (Docker defaults — override only if you know why)
# ---------------------------------------------------------------------------

CLAWCTL_DB=/var/lib/clawctl/clawctl.sqlite
CLAWCTL_REPORT_STAMP=/var/lib/clawctl/last-report.stamp
CLAWCTL_REPORT_AT=08:00

# Optional. If set, MUST equal http://<CLAWCTL_LISTEN> (trailing slash ignored),
# including the same port. Any other value is rejected before the DB opens.
# CLAWCTL_PUBLIC_URL=http://100.64.0.12:8787

# ---------------------------------------------------------------------------
# Notifications / deadman (optional)
# ---------------------------------------------------------------------------

# Preferred: built-in Telegram / webhook notifier. Secrets live in this file
# (mode 0600), not in process environment. See ops/notify.env.example.
# Docker: add -f ops/docker/docker-compose.notify.yml and set
# CLAWCTL_NOTIFY_ENV_HOST to the host path of that file (mounted at
# /etc/clawctl/notify.env). A host path in CLAWCTL_NOTIFY_ENV is not visible
# inside the container unless you mount it.
# CLAWCTL_NOTIFY_ENV=/etc/clawctl/notify.env
#
# Legacy: run an external command (ops/notify-telegram.sh). When this is set,
# built-in channels in the notify env file are not used. The child still
# inherits CLAWCTL_NOTIFY_ENV, so the script keeps working.
# CLAWCTL_NOTIFY_CMD=/path/to/notify-telegram.sh
# CLAWCTL_REPORT_PING_URL=https://hc-ping.com/<uuid>
# CLAWCTL_REPORT_PING_FAIL_URL=

# ---------------------------------------------------------------------------
# Optional Cloudflare Tunnel (separate compose file, not a profile)
# ---------------------------------------------------------------------------

# Compose v5 interpolates profile-disabled services. The token is therefore
# not referenced by docker-compose.yml. Set it here only when you also pass
#   -f ops/docker/docker-compose.tunnel.yml
# Missing token then fails at `docker compose` interpolation, before start.
# From Zero Trust → Networks → Tunnels → configure → install with token.
# CLOUDFLARE_TUNNEL_TOKEN=
#
# Point the tunnel's public hostname service URL at:
#   http://<same CLAWCTL_LISTEN value>
# Operator UI on that hostname will NOT authenticate today.
# Agent check-in over the public hostname is experimental only.
#
# CLAWCTL_VERSION is a build arg (default dev), not a Hub runtime setting.
# It becomes main.version and the agent-bootstrap/<version> directory.
# The image tag defaults to "local" when this variable is unset.
#
# RECOMMENDATION: Reusing a version string (such as the default "dev")
# never refreshes agent bootstrap bundles in an existing volume. For real
# deploys, always pass the git short SHA. Env files are not shell-expanded, so
# `CLAWCTL_VERSION=$(git rev-parse --short HEAD)` inside hub.env is taken
# literally. Put the value printed by `git rev-parse --short HEAD` into hub.env
# (e.g. `CLAWCTL_VERSION=d217deb`), or `export CLAWCTL_VERSION="$(git rev-parse --short HEAD)"`
# in the shell before compose.

# ---------------------------------------------------------------------------
# Optional R2 or generic S3 for large artifact / evidence blobs.
# Leave every variable empty to keep the local artifacts directory only.
# If any variable in a group is set, access key, secret, bucket, and https
# endpoint are all required. Do not set R2_* and S3_* together.
# SQLite keeps digests in object_blobs. Evidence excerpts stay in SQLite.
# R2_ACCOUNT_ID is optional; when set, the endpoint host must contain it.
# Region defaults: R2 "auto", S3 "us-east-1".
# ---------------------------------------------------------------------------

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=clawctl-artifacts
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto

# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Operator Terminal Limits
# ---------------------------------------------------------------------------

# CLAWCTL_TERMINAL_IDLE_TIMEOUT sets the idle timeout for operator terminals.
# A terminal is considered idle if there is no keyboard/paste input or window
# resize from the operator page. Output from the machine or background heartbeats
# do not reset this timer. A session closes automatically with an idle reason
# when this expires.
# Allowed bounds: 1m to 24h. Only whole seconds are accepted.
# Default if unset or empty: 30m.
# CLAWCTL_TERMINAL_IDLE_TIMEOUT=30m

# CLAWCTL_TERMINAL_MAX_LIFETIME sets the absolute maximum duration a terminal
# session can remain open, measured from when the session was created in the ledger.
# This limit cannot be extended by operator activity. If a session is already older
# than this limit when the operator connects, it closes immediately.
# Allowed bounds: 1m to 720h. Only whole seconds are accepted. Must be >= idle timeout.
# Default if unset or empty: 12h.
# CLAWCTL_TERMINAL_MAX_LIFETIME=12h
