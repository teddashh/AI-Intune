# clawctl-agent —— systemd system unit template
#
# install-agent.sh / upgrade-agent.sh 會在放進 /etc/systemd/system 前渲染
# @@CLAWCTL_AGENT_USER@@、@@CLAWCTL_AGENT_UID@@ 與 @@CLAWCTL_AGENT_HOME@@。
#
# Agent 仍以這個普通使用者執行，所以只能讀該使用者的 0600 憑證；
# 差別是 unit 由 system manager 建立 mount namespace。這讓
# ProtectSystem=strict / ProtectHome=read-only 在 systemd 249/252/259 都由有權限的
# manager 實際套用，而不是在 user manager 下被略過。

[Unit]
Description=clawctl agent (fleet observation)
Documentation=https://github.com/teddashh/AI-Intune
After=network-online.target
Wants=network-online.target
After=user@__CLAWCTL_AGENT_UID__.service
Wants=user@__CLAWCTL_AGENT_UID__.service

[Service]
Type=notify
User=@@CLAWCTL_AGENT_USER@@
Environment=HOME=@@CLAWCTL_AGENT_HOME@@
Environment=XDG_RUNTIME_DIR=/run/user/@@CLAWCTL_AGENT_UID@@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@@CLAWCTL_AGENT_UID@@/bus
ExecStart=@@CLAWCTL_AGENT_HOME@@/.local/bin/clawctl-agent
Restart=always
RestartSec=5

# WatchdogSec 由一條專屬的 goroutine 餵，週期是這裡的 1/3（30 秒）。
#
# ⚠ 這個數字不准單獨改。2026-09-03 全機隊每 90 秒被 SIGABRT 一次，
# 原因就是這一行寫 90、而程式那邊把餵食掛在 check-in 上（週期 96–144 秒）。
# 兩個檔案各自看都是合理的數字，合起來是團滅。
# cmd/clawctl-agent/watchdog_test.go 會真的讀這個檔並比對，改壞了測試會紅。
#
# ⚠ 而且那次團滅在 Hub 上是綠的 —— 因為每次重啟都會立刻送一顆 check-in，
# 心跳流看起來規律得不得了。這正是下面那句話成立的原因：
# 觀測那條 goroutine 卡住時，unit 不該被 watchdog 打死 ——
# 它應該活著並且繼續回報「我還在，但我卡在觀測」。被打死會讓這台看起來
# 像是正常重啟，而正常重啟看起來像沒事。
WatchdogSec=90

# ⚠ 沒有這行，安裝途中被 kill 會留下孤兒 wget/tar 佔著檔案，
# 下次重試會在一個不乾淨的目錄上跑。
KillMode=control-group

# 唯讀觀測不需要任何特權。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@@CLAWCTL_AGENT_HOME@@/.config/clawctl @@CLAWCTL_AGENT_HOME@@/.config/systemd/user/openclaw-gateway.service.d @@CLAWCTL_AGENT_HOME@@/.cache/clawctl @@CLAWCTL_AGENT_HOME@@/.local/share/clawctl @@CLAWCTL_AGENT_HOME@@/.openclaw
# ⚠ PrivateTmp 必須是 false：OpenClaw 的 log 在 /tmp/openclaw/（tmpfs），
# 那是輔助線索的來源。
PrivateTmp=false
# ⚠ 這裡刻意**沒有** PrivateDevices=true。
#
# Agent 需要觀測主機現有的 device 面，所以不用 PrivateDevices=true。
# 此外舊 user unit 時期實測過，PrivateDevices 隱含的 capability 操作會讓
# 那些 unit 以 status=218/CAPABILITIES 起不來。
#
#     Failed to drop capabilities: Operation not permitted
#     Failed at step CAPABILITIES ... status=218/CAPABILITIES
RestrictSUIDSGID=true
LockPersonality=true

# 觀測不該吃掉機器。一台因為監控而變慢的機器，人會把監控關掉。
CPUQuota=20%
# MemoryHigh makes the kernel reclaim page cache and throttle before the
# hard MemoryMax OOM kill. The cgroup counts child processes and page cache,
# not just the agent heap.
MemoryHigh=224M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
