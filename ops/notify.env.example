# Notify secrets for clawctl-hub built-in Telegram and webhook channels.
# chmod 0600 this file. Never commit it.
#
# Point the Hub at this file with CLAWCTL_NOTIFY_ENV / --notify-env.
# Secrets are read from this file only, never from flags or the process
# environment.

# Telegram (both keys are required together):
TELEGRAM_BOT_TOKEN=123456:TEST-TOKEN
TELEGRAM_CHAT_ID=-1000000000001

# Optional webhook. http:// is allowed only for loopback or 100.64.0.0/10.
# CLAWCTL_NOTIFY_WEBHOOK_URL=https://example.com/hooks/notify
# CLAWCTL_NOTIFY_WEBHOOK_SECRET=
